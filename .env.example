# WikiDoc 部署配置示例
#
# 用法：复制为 .env，填写后执行一键部署
#   cp .env.example .env
#   然后编辑 docker-compose.yml，在 services.wikidoc 下增加一行：
#     env_file: - .env
#   注意：Compose 不会自动把 .env 注入容器，必须显式声明 env_file；
#        或者把下面各项直接写在 compose 的 environment 段里。
#
# 修改 .env 后需重建容器生效：docker compose up -d

# ---------- 基础 ----------
# 容器内监听端口，镜像固定 3000，无需修改
PORT=3000
NODE_ENV=production

# 对外访问地址，用于 SSO 回调与通知消息中的链接拼接。
# 用域名或反向代理访问时必须设置，否则链接会指向 http://localhost:3000
WIKIDOC_PUBLIC_URL=http://wiki.corp.local

# ---------- 安全（生产环境必配）----------
# 敏感配置加密主密钥，用于加密存储 LDAP 绑定密码、OIDC Secret、SMTP 密码。
# 留空则由启动脚本自动生成并持久化到 /data/.master_key（务必纳入备份）。
# 自行生成：openssl rand -hex 32
WIKIDOC_MASTER_KEY=

# 令牌签名密钥。不设置时容器每次重启都会重新随机生成，
# 导致所有人登录态失效，生产环境务必固定两个不同的值：
#   openssl rand -hex 32
WIKIDOC_JWT_SECRET=
WIKIDOC_JWT_REFRESH_SECRET=

# 首次初始化的管理员密码，仅 users 表为空时生效，登录后请立即修改
WIKIDOC_ADMIN_PASSWORD=Admin@12345

# 反向代理终止 TLS（对外 HTTPS）时设为 true，同时启用 Cookie Secure 与 HSTS。
# 内网 HTTP 直连保持 false
WIKIDOC_COOKIE_SECURE=false

# ---------- 以下通常无需修改 ----------
# 数据目录。镜像内已固定为 /data（对应宿主机 ./data），命令行部署时才需覆盖
# WIKIDOC_DATA_DIR=/data

# LDAP / OIDC SSO / 通知渠道（企业微信、飞书、SMTP）均不在此处配置，
# 部署完成后到 Web 界面「管理后台 → 系统设置」填写，保存即时生效。
